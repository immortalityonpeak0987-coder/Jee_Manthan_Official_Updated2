# ===================================================
# JEE MANTHAN - ENVIRONMENT VARIABLES
# ===================================================
# GROQ_API_KEY: Paste your Groq API key from https://console.groq.com/keys
# (Upload this in Vercel Project Settings > Environment Variables for production)
GROQ_API_KEY="your_groq_api_key_here"
# GROQ_MODEL: Default is llama-3.3-70b-versatile (can also use llama-3.1-8b-instant or deepseek-r1-distill-llama-70b)
GROQ_MODEL="llama-3.3-70b-versatile"
# GEMINI_API_KEY: Optional fallback / vision model key for diagram & handwritten question scanning
GEMINI_API_KEY="your_gemini_api_key_here"
# APP_URL: The base URL where this applet is hosted
APP_URL="http://localhost:3000"
